diff --git a/pkg/epuboptions/page_crops.go b/pkg/epuboptions/page_crops.go
new file mode 100644
index 0000000..99c13b3
--- /dev/null
+++ b/pkg/epuboptions/page_crops.go
@@ -0,0 +1,81 @@
+package epuboptions
+
+import (
+	"encoding/json"
+	"fmt"
+	"image"
+	"math"
+	"os"
+	"strconv"
+)
+
+// PageCrop is the part of a page kept, chosen by hand: x0, y0, x1, y1 in fractions (0 to 1) of the source page.
+type PageCrop [4]float64
+
+// PageCrops are the crops chosen page by page (-pagecrops).
+// A page with a crop is this rectangle, as one page: it is never split, and not auto-cropped.
+type PageCrops struct {
+	// Pages by index of the page in the source, in the sort order (0 = first page).
+	Pages map[int]PageCrop
+	// Default is used for the pages without their own crop, when set.
+	Default *PageCrop
+}
+
+// For gives the crop of the page, if it has one.
+func (p PageCrops) For(id int) (PageCrop, bool) {
+	if c, ok := p.Pages[id]; ok {
+		return c, true
+	}
+	if p.Default != nil {
+		return *p.Default, true
+	}
+	return PageCrop{}, false
+}
+
+// Len is the number of pages with their own crop.
+func (p PageCrops) Len() int {
+	return len(p.Pages)
+}
+
+// Rect is the crop in pixels of a page of the given bounds, at least 1x1.
+func (c PageCrop) Rect(b image.Rectangle) image.Rectangle {
+	w, h := float64(b.Dx()), float64(b.Dy())
+	r := image.Rect(
+		b.Min.X+int(math.Round(c[0]*w)), b.Min.Y+int(math.Round(c[1]*h)),
+		b.Min.X+int(math.Round(c[2]*w)), b.Min.Y+int(math.Round(c[3]*h)),
+	).Intersect(b)
+	if r.Dx() < 1 || r.Dy() < 1 {
+		return image.Rect(r.Min.X, r.Min.Y, r.Min.X+1, r.Min.Y+1).Intersect(b)
+	}
+	return r
+}
+
+// LoadPageCrops reads a JSON file {"<page index>": [x0, y0, x1, y1], "*": [x0, y0, x1, y1]},
+// "*" being the crop of the pages without their own.
+func LoadPageCrops(path string) (PageCrops, error) {
+	crops := PageCrops{Pages: map[int]PageCrop{}}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return crops, fmt.Errorf("page crops: %w", err)
+	}
+	var raw map[string]PageCrop
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return crops, fmt.Errorf("page crops %s: %w", path, err)
+	}
+	for key, c := range raw {
+		if c[0] < 0 || c[1] < 0 || c[2] > 1 || c[3] > 1 || c[0] >= c[2] || c[1] >= c[3] {
+			return crops, fmt.Errorf("page crops %s: crop of %q should be x0, y0, x1, y1 between 0 and 1, with x0 < x1 and y0 < y1", path, key)
+		}
+		if key == "*" {
+			d := c
+			crops.Default = &d
+			continue
+		}
+		id, err := strconv.Atoi(key)
+		if err != nil || id < 0 {
+			return crops, fmt.Errorf("page crops %s: %q is not a page index (0 = first page) or \"*\"", path, key)
+		}
+		crops.Pages[id] = c
+	}
+	return crops, nil
+}
diff --git a/pkg/epuboptions/page_crops_test.go b/pkg/epuboptions/page_crops_test.go
new file mode 100644
index 0000000..02cc717
--- /dev/null
+++ b/pkg/epuboptions/page_crops_test.go
@@ -0,0 +1,78 @@
+package epuboptions
+
+import (
+	"image"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func writeCrops(t *testing.T, content string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "crops.json")
+	if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestLoadPageCrops(t *testing.T) {
+	crops, err := LoadPageCrops(writeCrops(t, `{"0": [0.5, 0, 1, 1], "3": [0, 0.1, 0.9, 1], "*": [0, 0, 1, 1]}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if crops.Len() != 2 {
+		t.Errorf("want 2 pages, got %d", crops.Len())
+	}
+	if c, ok := crops.For(0); !ok || c != (PageCrop{0.5, 0, 1, 1}) {
+		t.Errorf("page 0: %v %v", c, ok)
+	}
+	if c, ok := crops.For(7); !ok || c != (PageCrop{0, 0, 1, 1}) {
+		t.Errorf("page 7 should use the default: %v %v", c, ok)
+	}
+}
+
+func TestPageCropsWithoutDefault(t *testing.T) {
+	crops, err := LoadPageCrops(writeCrops(t, `{"1": [0, 0, 0.5, 1]}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := crops.For(0); ok {
+		t.Error("page 0 has no crop")
+	}
+	var none PageCrops
+	if _, ok := none.For(0); ok {
+		t.Error("no crops at all")
+	}
+}
+
+func TestLoadPageCropsErrors(t *testing.T) {
+	for name, content := range map[string]string{
+		"not json":    `{"0": [0, 0`,
+		"outside":     `{"0": [0, 0, 1.5, 1]}`,
+		"empty":       `{"0": [0.5, 0, 0.5, 1]}`,
+		"negative":    `{"0": [-0.1, 0, 1, 1]}`,
+		"bad key":     `{"cover": [0, 0, 1, 1]}`,
+		"negative id": `{"-1": [0, 0, 1, 1]}`,
+	} {
+		if _, err := LoadPageCrops(writeCrops(t, content)); err == nil {
+			t.Errorf("%s: an error was expected", name)
+		}
+	}
+	if _, err := LoadPageCrops(filepath.Join(t.TempDir(), "missing.json")); err == nil {
+		t.Error("missing file: an error was expected")
+	}
+}
+
+func TestPageCropRect(t *testing.T) {
+	b := image.Rect(0, 0, 3000, 2000)
+	if r := (PageCrop{0.5, 0, 1, 1}).Rect(b); r != image.Rect(1500, 0, 3000, 2000) {
+		t.Errorf("right half: %v", r)
+	}
+	if r := (PageCrop{0.25, 0.1, 0.75, 0.9}).Rect(image.Rect(100, 100, 500, 300)); r != image.Rect(200, 120, 400, 280) {
+		t.Errorf("offset bounds: %v", r)
+	}
+	if r := (PageCrop{0.5, 0.5, 0.5001, 0.5001}).Rect(image.Rect(0, 0, 10, 10)); r.Dx() < 1 || r.Dy() < 1 {
+		t.Errorf("at least 1x1: %v", r)
+	}
+}
